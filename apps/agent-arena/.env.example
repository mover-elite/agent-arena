# agent-arena reads the repo-root .env too — NETWORK, VENUE_ID, DRY_RUN,
# PRIVATE_KEY, AUTO_CLAIM* all come from there (see ../../.env.example). The
# vars below are agent-arena's own knobs; the canonical copy of this list
# lives in ../../.env.example under the "agent-arena" heading — keep them in
# sync.

# ── LLM ────────────────────────────────────────────────────────────────────
# Which vendor the PLATFORM-OWNED seeded agents reason with: "anthropic"
# (default) or "gemini". Every user-owned agent reasons with that user's own
# stored key instead (set on /account.html), so these are only the demo
# agents' credentials.
LLM_PROVIDER=anthropic

# Required only if LLM_PROVIDER=anthropic. Billing/identity verification at
# console.anthropic.com (separate from any claude.ai subscription).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required only if LLM_PROVIDER=gemini. Free key (no billing/KYC) at
# aistudio.google.com. Uses @google/genai's interactions API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ── Abuse limits (in-memory, per-process; see server/rate-limit.ts) ────────
# Signed-in accounts only: cap held agents and spawn rate (each new agent
# provisions a wallet + drips treasury gas). Auth attempts are per-IP.
# MAX_AGENTS_PER_USER=12
# AGENT_CREATES_PER_HOUR=6
# AUTH_ATTEMPTS_PER_MIN=20
# REGEN_COOLDOWN_MS=45000        # min gap between /regenerate calls per agent
# DRYRUN_PER_MIN=8              # /dry-run calls per minute per agent

# ── Seed data ──────────────────────────────────────────────────────────────
# Seed two platform-owned flagships ("Momentum Max", "Fade the Crowd") when
# the agent table is empty at startup. Off by default: they reason with the
# key above and fund a real wallet from the treasury.
# SEED_FLAGSHIP_AGENTS=true

# ── Market loop ────────────────────────────────────────────────────────────
# How often agents re-reason. LLM spend scales directly with this; the
# dashboard stays live off a separate 5s price-feed loop regardless, so keep
# this as slow as you can tolerate. Default 60s.
# CYCLE_INTERVAL_MS=60000
# WATCHLIST=BTC,ETH
# How often the dashboard's BTC/ETH spot price + candles refresh (cheap oracle
# reads, no LLM). Default 5s.
# PRICE_FEED_INTERVAL_MS=5000

# Book granularity (raw units). ec-core's testnet default is lot=1 (stale); the
# live DreamDEX venue enforces lot == tick == 1000 — an order size off that grid
# reverts (custom error 0x4f174b29). Pin both; verified via `npm run verify:live`.
MM_TICK=1000
MM_LOT=1000

# ── Risk gates (every trade passes through these) ──────────────────────────
# MAX_POSITION_PER_MARKET_USD=50
# MAX_CYCLE_NOTIONAL_USD=150
# DAILY_LOSS_CAP_USD=200
# MIN_CONFIDENCE_THRESHOLD=0.6
# MIN_EDGE_THRESHOLD=0.05
# TRADE_COOLDOWN_MS=60000

# ── Wallets / treasury ────────────────────────────────────────────────────
# Every agent gets its own dedicated testnet wallet. The repo-root
# PRIVATE_KEY is the TREASURY: it drips native gas to each new agent wallet
# and reasons for the platform-owned seeded agents — it is NOT the wallet any
# agent trades from. Fund it at testnet.somnia.network.
#
# How much native token the treasury drips to a newly-live agent wallet.
# Keep above ~0.6: the markets-SDK write path reserves 10M gas × 60 gwei per
# tx up front (real gas is a tiny fraction), so a smaller drip gets the
# agent's faucet/order txns rejected pre-execution.
# AGENT_WALLET_GAS_STT=2
# Funding an agent's wallet is now an explicit OWNER action (the "Fund this
# agent" button on its page) — agents never provision themselves. This caps how
# many wallets the treasury will fund per rolling hour, as a burst guard.
# MAX_AGENT_FUNDS_PER_HOUR=20

# ── On-chain reasoning receipts (off by default) ──────────────────────────
# When enabled, every actionable decision's reasoning hash is committed via
# the treasury wallet (as a relayer — never touches trading funds).
# ReasoningRegistry.sol is deployed on first commit unless an address is set.
# REASONING_RECEIPTS_ENABLED=false
# REASONING_REGISTRY_ADDRESS=

# ── Accounts / sessions ───────────────────────────────────────────────────
# Stored user API keys are encrypted with this (AES-256-GCM). 64 hex chars
# (32 bytes). Auto-generated and persisted to logs/.session-secret if unset.
# SESSION_ENCRYPTION_KEY=
# Bearer-token session lifetime (ms); slid forward on use. Default 7 days.
# SESSION_TTL_MS=604800000

# ── LLM spend control (see server/llm-cache.ts + server/llm-budget.ts) ────
# An agent's reasoning call is skipped for a cycle unless a watched market
# moved by ≥ this many probability points since its last look…
# SKIP_UNCHANGED_THRESHOLD=0.02
# …or this long has passed regardless (staleness cap, ms).
# FORCE_REEVALUATE_MS=900000
# Hard per-agent floor between reasoning calls, ms — volatility can't beat it.
# LLM_MIN_CALL_INTERVAL_MS=120000
# Hard per-agent ceiling on reasoning calls per UTC day; agent HOLDs once hit.
# LLM_MAX_CALLS_PER_DAY=200
# "Coded" agents make ZERO per-cycle LLM calls — one generation call at
# creation, then a sandboxed decide() every cycle. This caps that sandbox run.
# STRATEGY_CODE_TIMEOUT_MS=500

# ── Storage ──────────────────────────────────────────────────────────────
# AGENT_ARENA_DB_PATH=./logs/agent-arena.sqlite
# AGENT_ARENA_LOG_DIR=./logs

# ── verify:live script only ──────────────────────────────────────────────
# Notional size (USD) of the single IOC that `npm run verify:live -- --trade`
# places. Keep tiny.
# VERIFY_TRADE_USD=1
